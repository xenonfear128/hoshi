DOMAIN=ssh.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
ALLOW_REGISTRATION=false
TASK_RETENTION_DAYS=30
# Match the internal Docker network; do not expose the app port directly
